# Optional: enables live Gemini answers/quizzes. Without it, Orbit uses curated offline demos.
# Prefer server-only GEMINI_API_KEY on Vercel for production.
VITE_GEMINI_API_KEY=

# Phase 0 — auth switches from local demo → Supabase when set
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Alerts — Web Push (generate with: npx web-push generate-vapid-keys)
# Public key is safe in the client; private key is server-only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@orbit.app

# Server-only (Vercel / Edge). Needed for push fan-out + SMS log.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional shared secret for server-to-server notify calls (clients use user JWT)
# NOTIFY_INTERNAL_SECRET=

# SMS — MSG91 (India). Leave empty until DLT templates are approved.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=ORBITA
# MSG91_TEMPLATE_ID=

# Razorpay (optional live fees)
# VITE_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
