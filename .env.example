# Client (public) — safe to expose in the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_RAZORPAY_KEY_ID=
VITE_DEFAULT_SCHOOL_CODE=SUNRISE
VITE_DEFAULT_CLASS_NAME=Grade 8-A
# Optional demo fixtures in non-production builds (set to 1 for full walkthrough data)
VITE_ENABLE_DEMO_FIXTURES=

# Optional client Sentry DSN (public). Auth token for source maps is CI-only (never VITE_).
VITE_SENTRY_DSN=

# Server-only — NEVER prefix with VITE_. Set on Vercel / Edge only.
# Do NOT set VITE_GEMINI_API_KEY (removed; would risk client bundle leakage).
GEMINI_API_KEY=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@orbit.app
NOTIFY_INTERNAL_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Local/preview only. Never set on Vercel production. Required for /api/ensure-demo.
ORBIT_ALLOW_DEMO_ENSURE=
# Local Vite only. Allows /api/gemini without Supabase JWT for local-demo walkthroughs.
# Never set on Vercel production.
ORBIT_DEV_AI_OPEN=

