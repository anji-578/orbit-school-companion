{
  "name": "orbit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:share": "vite --host",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:emu": "bash scripts/android-emulator.sh",
    "pilot100:generate": "node scripts/generate-pilot100.mjs && node scripts/generate-pilot100-auth-sql.mjs",
    "pilot100:provision": "node scripts/provision-pilot100.mjs",
    "pilot100:teardown": "node scripts/teardown-pilot100.mjs",
    "demo50:generate": "node scripts/generate-demo50.mjs",
    "test:smoke": "node scripts/smoke-hardening.mjs",
    "test:razorpay": "node scripts/verify-razorpay-local.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "^3.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "xlsx": "^0.18.5"
  }
}
